# Copia este archivo a .env.local y completa los valores. Ver docs/SPEC.md §5.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# OAuth Client de Google Cloud (tipo "Aplicación web")
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Developer token de Google Ads (MCC → Herramientas → Centro de API)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Opcionales
# GOOGLE_ADS_API_VERSION=v25
# Sólo si los usuarios acceden a sus cuentas a través de una cuenta administradora (MCC)
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

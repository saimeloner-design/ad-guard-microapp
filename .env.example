# Copia este archivo a .env.local y completa los valores. Ver docs/SPEC.md §5.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# OAuth Client de Google Cloud (tipo "Aplicación web")
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Developer token de Google Ads (MCC → Herramientas → Centro de API)
GOOGLE_ADS_DEVELOPER_TOKEN=

# App de Meta (developers.facebook.com → AdsGuard → Configuración de la app → Básica)
# Redirect URI: http://localhost:3000/api/auth/callback/facebook
META_APP_ID=
META_APP_SECRET=
# Inicio de sesión con Facebook para empresas → Configuraciones ("AdsGuard login")
META_LOGIN_CONFIG_ID=1901074967923391

# Opcionales
# GOOGLE_ADS_API_VERSION=v25
# META_GRAPH_API_VERSION=v26.0

# Sentry (monitoreo de errores y logs)
# DSN: Sentry → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Sólo para subir source maps en el build (configúralos en Vercel, no hace falta en local)
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
